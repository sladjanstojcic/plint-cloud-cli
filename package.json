{
  "name": "plint",
  "version": "0.1.0",
  "description": "Static hosting CLI for Bunny.net",
  "type": "module",
  "bin": {
    "plint": "./src/cli-bin.js"
  },
  "scripts": {
    "test": "find test/unit -name '*.test.js' -print0 | xargs -0 node --test",
    "test:unit": "find test/unit -name '*.test.js' -print0 | xargs -0 node --test",
    "test:integration": "find test/integration -name '*.test.js' -print0 | xargs -0 node --env-file=.env --test",
    "test:stress": "node scripts/stress-cli.mjs",
    "test:manual": "node scripts/manual-verify.mjs",
    "test:cleanup": "node scripts/test-cleanup.mjs",
    "test:e2e": "bash scripts/e2e/remote.sh",
    "build": "node scripts/build-release.mjs"
  },
  "files": [
    "src/"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sladjanstojcic/plint-cloud-cli.git"
  },
  "homepage": "https://plint.cloud",
  "bugs": "https://github.com/sladjanstojcic/plint-cloud-cli/issues",
  "dependencies": {
    "@inquirer/prompts": "^8.4.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.0",
    "fastest-levenshtein": "^1.0.16",
    "human-id": "^4.1.3",
    "ignore": "^7.0.5",
    "is-interactive": "^2.0.0",
    "mime-types": "^3.0.1",
    "ora": "^10.0.0",
    "p-limit": "^7.3.0",
    "proper-lockfile": "^4.1.2",
    "write-file-atomic": "^7.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "tar": "^7.5.13"
  }
}
